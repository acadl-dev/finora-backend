# Copie para secrets.env (que está no .gitignore) e troque os valores.
# JWT_SECRET: Base64 de pelo menos 32 bytes. Use o MESMO valor do .env do finora
# se quiser reaproveitar tokens; ou gere um novo:
#   PowerShell: [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }))
#   Linux/WSL : openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=troque-por-um-base64-de-64-bytes
POSTGRES_PASSWORD=postgres
RABBITMQ_PASSWORD=finora
GRAFANA_ADMIN_PASSWORD=admin
